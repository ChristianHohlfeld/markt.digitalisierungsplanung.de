                "dataPath": "process.betrag",
                "dataRole": "field",
                "dataLabel": "Betrag (EUR)"
              },
              {
                "id": "kostenstelle",
                "type": "daisy",
                "variant": "input",
                "text": "Kostenstelle",
                "dataPath": "process.kostenstelle",
                "dataRole": "field",
                "dataLabel": "Kostenstelle"
              },
              {
                "id": "zweck",
                "type": "daisy",
