              {
                "id": "h",
                "type": "heading",
                "text": "Prüfung"
              },
              {
                "id": "t",
                "type": "text",
                "text": "Bitte die Angaben prüfen. Die genauen Werte (z. B. Betrag) stehen in der Freigabe und werden mit ihr signiert."
              },
              {
                "id": "n",
                "type": "note",
                "text": "Bis 5.000 € genügt diese Freigabe. Darüber entscheidet zusätzlich die Geschäftsführung."
              }
            ],
            "data": {},
            "dataTypes": {}
          },
          {
            "key": "geschaeftsfuehrung",
            "title": "Freigabe Geschäftsführung",
            "body": "Ab 5.000 € geben zwei Personen der Geschäftsführung frei.",
            "components": [
              {
                "id": "h",
                "type": "heading",
                "text": "Geschäftsführung"
              },
              {
                "id": "t",
                "type": "text",
                "text": "Bitte die Angaben prüfen. Die genauen Werte (z. B. Betrag) stehen in der Freigabe und werden mit ihr signiert."
              }
            ],
            "data": {},
            "dataTypes": {}
          },
          {
            "key": "freigegeben",
            "title": "Budget freigegeben",
            "body": "Das Budget ist verbindlich freigegeben. Der signierte Nachweis steht als PDF bereit.",
            "components": [
              {
                "id": "h",
                "type": "heading",
                "text": "Budget freigegeben"
              },
              {
                "id": "n",
                "type": "note",
                "text": "Freigabenachweis (PDF) im Ablauf unter „Abgeschlossene Transaktionen“."
              }
            ],
            "data": {},
            "dataTypes": {}
          }
        ],
        "transitions": [
          {
            "from": "antrag",
            "to": "pruefung",
            "label": "Zur Freigabe einreichen",
            "decision": "routine",
            "triggerType": "button",
            "condition": "process.betrag.value > 0 && process.kostenstelle.value"
          },
          {
            "from": "pruefung",
            "to": "freigegeben",
            "label": "Freigeben (bis 5.000 €)",
            "decision": "human",
            "triggerType": "button",
            "condition": "process.betrag.value <= 5000",
            "approval": {
              "method": "qr",
              "excludeInitiator": true
            }
          },
          {
            "from": "pruefung",
            "to": "geschaeftsfuehrung",
            "label": "Befürworten (über 5.000 €)",
            "decision": "human",
            "triggerType": "button",
            "condition": "process.betrag.value > 5000",
            "approval": {
              "method": "qr",
              "excludeInitiator": true
            }
          },
          {
            "from": "pruefung",
            "to": "antrag",
            "label": "Zur Überarbeitung zurück",
            "decision": "routine",
            "triggerType": "button"
          },
          {
            "from": "geschaeftsfuehrung",
            "to": "freigegeben",
            "label": "Freigeben (Geschäftsführung)",
            "decision": "human",
            "triggerType": "button",
            "approval": {
              "method": "qr",
              "quorum": 2,
              "excludeInitiator": true
            }
          },
          {
            "from": "geschaeftsfuehrung",
            "to": "antrag",
            "label": "Zur Überarbeitung zurück",
            "decision": "routine",
            "triggerType": "button"
          }
        ]
