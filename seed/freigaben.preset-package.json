                "dataPath": "process.zweck",
                "dataRole": "field",
                "dataLabel": "Zweck / Begründung"
              }
            ],
            "data": {},
            "dataTypes": {}
          },
          {
            "key": "pruefung",
            "title": "Prüfung Budgetverantwortung",
            "body": "Die budgetverantwortliche Person prüft Betrag und Zweck.",
